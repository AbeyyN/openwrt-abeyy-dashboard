#!/bin/sh

echo "Content-Type: application/json"
echo ""

[ -f /etc/abeyy-dashboard.conf ] && . /etc/abeyy-dashboard.conf

WAN_IF="${WAN_IF:-wwan0}"

RX="/sys/class/net/$WAN_IF/statistics/rx_bytes"
TX="/sys/class/net/$WAN_IF/statistics/tx_bytes"

if [ ! -r "$RX" ] || [ ! -r "$TX" ]; then
    cat <<JSON
{
  "interface":"$WAN_IF",
  "download":"0 Mbps",
  "upload":"0 Mbps"
}
JSON
    exit 0
fi

RX1=$(cat "$RX")
TX1=$(cat "$TX")

sleep 1

RX2=$(cat "$RX")
TX2=$(cat "$TX")

DOWN=$(awk -v b="$((RX2-RX1))" 'BEGIN {printf "%.2f", b*8/1000000}')
UP=$(awk -v b="$((TX2-TX1))" 'BEGIN {printf "%.2f", b*8/1000000}')

cat <<JSON
{
  "interface":"$WAN_IF",
  "download":"$DOWN Mbps",
  "upload":"$UP Mbps"
}
JSON
